# This file serves as an example of what your .env file should look like.
# Replace the variables defined here with those applicable on your own system.
# Then copy the contents into a file called ".env" and place it in project's
# root directory.
#
# The analysis window (START_DATE, END_DATE) is deliberately NOT here. It is a
# committed constant in src/settings.py, so that two people with different .env
# files who build the same commit get the same output.

# WRDS login, used for the CRSP and TAQ pulls. Password is handled by the wrds
# package's own .pgpass prompt, not stored here.
WRDS_USERNAME=jdoe

# Where the pulled and cleaned data lives. The minute-bar panel is roughly
# 10 GB for the paper's 2005-2012 sample, so point this at a disk with room
# if you do not want it inside the repo.
DATA_DIR=_data
